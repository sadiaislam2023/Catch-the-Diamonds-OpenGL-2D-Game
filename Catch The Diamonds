SCREEN_WIDTH = 500
SCREEN_HEIGHT = 700
def determine_line_octant(start_x, start_y, end_x, end_y):
    delta_x = end_x - start_x
    delta_y = end_y - start_y
    abs_delta_x = abs(delta_x)
    abs_delta_y = abs(delta_y)
    if abs_delta_x >= abs_delta_y:
        if delta_x >= 0 and delta_y >= 0: return 0
        if delta_x < 0 and delta_y >= 0: return 3
        if delta_x < 0 and delta_y < 0: return 4
        return 7
    else:
        if delta_x >= 0 and delta_y >= 0: return 1
        if delta_x < 0 and delta_y >= 0: return 2
        if delta_x < 0 and delta_y < 0: return 5
        return 6
def transform_to_octant_zero(pos_x, pos_y, octant):
    if octant == 0: return pos_x, pos_y
    if octant == 1: return pos_y, pos_x
    if octant == 2: return pos_y, -pos_x
    if octant == 3: return -pos_x, pos_y
    if octant == 4: return -pos_x, -pos_y
    if octant == 5: return -pos_y, -pos_x
    if octant == 6: return -pos_y, pos_x
    if octant == 7: return pos_x, -pos_y
    return pos_x, pos_y
def transform_from_octant_zero(pos_x, pos_y, octant):
    if octant == 0: return pos_x, pos_y
    if octant == 1: return pos_y, pos_x
    if octant == 2: return -pos_y, pos_x
    if octant == 3: return -pos_x, pos_y
    if octant == 4: return -pos_x, -pos_y
    if octant == 5: return -pos_y, -pos_x
    if octant == 6: return pos_y, -pos_x
    if octant == 7: return pos_x, -pos_y
    return pos_x, pos_y
def midpoint_line_points_octant_zero(start_x, start_y, end_x, end_y, octant):
    delta_x = end_x - start_x
    delta_y = end_y - start_y
    decision_param = 2 * delta_y - delta_x
    inc_east = 2 * delta_y
    inc_northeast = 2 * (delta_y - delta_x)
    current_y = start_y
    point_list = []
    for current_x in range(start_x, end_x + 1):
        original_x, original_y = transform_from_octant_zero(current_x, current_y, octant)
        point_list.append((int(round(original_x)), int(round(original_y))))
        if decision_param > 0:
            decision_param += inc_northeast
            current_y += 1
        else:
            decision_param += inc_east
    return point_list
def draw_line_segment_midpoint(start_x, start_y, end_x, end_y):
    octant = determine_line_octant(start_x, start_y, end_x, end_y)
    start_x_zero, start_y_zero = transform_to_octant_zero(start_x, start_y, octant)
    end_x_zero, end_y_zero = transform_to_octant_zero(end_x, end_y, octant)
    if start_x_zero > end_x_zero:
        start_x_zero, end_x_zero = end_x_zero, start_x_zero
        start_y_zero, end_y_zero = end_y_zero, start_y_zero
    start_x_zero = int(round(start_x_zero)); start_y_zero = int(round(start_y_zero)); end_x_zero = int(round(end_x_zero)); end_y_zero = int(round(end_y_zero))
    point_list = midpoint_line_points_octant_zero(start_x_zero, start_y_zero, end_x_zero, end_y_zero, octant)
    glBegin(GL_POINTS)
    for px, py in point_list:
        glVertex2i(px, py)
    glEnd()
def draw_rectangle_outline_lines(pos_x, pos_y, width, height):
    draw_line_segment_midpoint(pos_x, pos_y, pos_x + width, pos_y)
    draw_line_segment_midpoint(pos_x + width, pos_y, pos_x + width, pos_y + height)
    draw_line_segment_midpoint(pos_x + width, pos_y + height, pos_x, pos_y + height)
    draw_line_segment_midpoint(pos_x, pos_y + height, pos_x, pos_y)
class GameStatus:
    def __init__(self):
        self.current_score = 0
        self.is_active = True
        self.is_frozen = False
        self.is_auto_pilot = False
        self.gem_fall_rate = 120.0
        self.last_frame_time = time.time()
def clamp_value(value, min_val, max_val):
    return max(min_val, min(max_val, value))
class GemCatcher:
    def __init__(self):
        self.width = 120
        self.height = 12
        self.pos_x = SCREEN_WIDTH // 2 - self.width // 2
        self.pos_y = 18
        self.display_color = (1.0, 1.0, 1.0)
        self.move_speed = 420.0
    def draw(self):
        glColor3f(*self.display_color)
        inset_amount = 18
        pos_x = int(round(self.pos_x))
        pos_y = int(round(self.pos_y))
        width = self.width
        height = self.height
        draw_line_segment_midpoint(pos_x + inset_amount // 2, pos_y + height, pos_x + width - inset_amount // 2, pos_y + height)
        draw_line_segment_midpoint(pos_x + width - inset_amount // 2, pos_y + height, pos_x + width, pos_y)
        draw_line_segment_midpoint(pos_x + width, pos_y, pos_x, pos_y)
        draw_line_segment_midpoint(pos_x, pos_y, pos_x + inset_amount // 2, pos_y + height)
    def move_towards_target_x(self, target_x, delta_time):
        center_x = self.pos_x + self.width / 2
        diff_x = target_x - center_x
        max_step = self.move_speed * delta_time
        step_x = clamp_value(diff_x, -max_step, max_step)
        self.pos_x += step_x
        self.pos_x = clamp_value(self.pos_x, 0, SCREEN_WIDTH - self.width)
    def move_by_x_delta(self, delta_x):
        self.pos_x += delta_x
        self.pos_x = clamp_value(self.pos_x, 0, SCREEN_WIDTH - self.width)
class FallingGem:
    def __init__(self):
        self.gem_size = 20
        self.reset_gem_position()
    def reset_gem_position(self):
        self.pos_x = random.randint(60, SCREEN_WIDTH - 60)
        self.pos_y = SCREEN_HEIGHT - 80
        while True:
            c = (random.random(), random.random(), random.random())
            if sum(c) > 1.2:
                self.display_color = c
                break
    def update_gem_position(self, delta_time, fall_rate):
        self.pos_y -= fall_rate * delta_time
    def draw(self):
        glColor3f(*self.display_color)
        cx = int(round(self.pos_x)); cy = int(round(self.pos_y)); half = self.gem_size // 2
        v1 = (cx, cy + half); v2 = (cx + half, cy); v3 = (cx, cy - half); v4 = (cx - half, cy)
        draw_line_segment_midpoint(*v1, *v2); draw_line_segment_midpoint(*v2, *v3); draw_line_segment_midpoint(*v3, *v4); draw_line_segment_midpoint(*v4, *v1)
class ControlButton:
    def __init__(self, pos_x, pos_y, width, height, color, icon_renderer, action_callback):
        self.pos_x = pos_x; self.pos_y = pos_y; self.width = width; self.height = height
        self.display_color = color; self.icon_renderer = icon_renderer; self.action_callback = action_callback
    def draw(self):
        glColor3f(*self.display_color)
        draw_rectangle_outline_lines(self.pos_x, self.pos_y, self.width, self.height)
        center_x = self.pos_x + self.width / 2; center_y = self.pos_y + self.height / 2
        self.icon_renderer(center_x, center_y, min(self.width, self.height) * 0.6)
    def is_hit(self, mouse_x, mouse_y):
        return self.pos_x <= mouse_x <= self.pos_x + self.width and self.pos_y <= mouse_y <= self.pos_y + self.height
def render_icon_reset(center_x, center_y, size):
    glColor3f(0.0, 0.8, 0.8)
    s = size
    draw_line_segment_midpoint(center_x + s*0.3, center_y + s*0.5, center_x - s*0.3, center_y)
    draw_line_segment_midpoint(center_x + s*0.3, center_y - s*0.5, center_x - s*0.3, center_y)
def render_icon_pause_bars(center_x, center_y, size):
    glColor3f(1.0, 0.8, 0.0)
    s = size
    bar_width = s * 0.12
    gap_half_height = s * 0.22
    draw_line_segment_midpoint(center_x - bar_width - bar_width/2, center_y - gap_half_height, center_x - bar_width - bar_width/2, center_y + gap_half_height)
    draw_line_segment_midpoint(center_x + bar_width + bar_width/2, center_y - gap_half_height, center_x + bar_width + bar_width/2, center_y + gap_half_height)
def render_icon_play_triangle(center_x, center_y, size):
    glColor3f(1.0, 0.8, 0.0)
    s = size
    v1 = (center_x - s*0.3, center_y + s*0.45); v2 = (center_x - s*0.3, center_y - s*0.45); v3 = (center_x + s*0.45, center_y)
    draw_line_segment_midpoint(*v1, *v2); draw_line_segment_midpoint(*v2, *v3); draw_line_segment_midpoint(*v3, *v1)
def render_icon_quit(center_x, center_y, size):
    glColor3f(1.0, 0.0, 0.0)
    s = size
    draw_line_segment_midpoint(center_x - s*0.45, center_y + s*0.45, center_x + s*0.45, center_y - s*0.45)
    draw_line_segment_midpoint(center_x - s*0.45, center_y - s*0.45, center_x + s*0.45, center_y + s*0.45)
def get_object_bounding_box(game_object):
    if isinstance(game_object, GemCatcher):
        return (game_object.pos_x, game_object.pos_y, game_object.width, game_object.height)
    if isinstance(game_object, FallingGem):
        half = game_object.gem_size / 2
        return (game_object.pos_x - half, game_object.pos_y - half, game_object.gem_size, game_object.gem_size)
    return (0,0,0,0)
def check_box_overlap(box_a, box_b):
    x1,y1,w1,h1 = box_a; x2,y2,w2,h2 = box_b
    return x1 < x2 + w2 and x1 + w1 > x2 and y1 < y2 + h2 and y1 + h1 > y2
game_status = GameStatus()
player_catcher = GemCatcher()
falling_gem = FallingGem()
MARGIN = 20
BUTTON_WIDTH = 60
BUTTON_HEIGHT = 40
reset_game_button = ControlButton(MARGIN, SCREEN_HEIGHT - MARGIN - BUTTON_HEIGHT, BUTTON_WIDTH, BUTTON_HEIGHT, (0.0, 0.0, 0.0), render_icon_reset, lambda: reset_game())
pause_game_button = ControlButton(SCREEN_WIDTH//2 - BUTTON_WIDTH//2, SCREEN_HEIGHT - MARGIN - BUTTON_HEIGHT, BUTTON_WIDTH, BUTTON_HEIGHT, (0.0,0.0,0.0), render_icon_pause_bars, lambda: toggle_game_freeze())
quit_game_button = ControlButton(SCREEN_WIDTH - MARGIN - BUTTON_WIDTH, SCREEN_HEIGHT - MARGIN - BUTTON_HEIGHT, BUTTON_WIDTH, BUTTON_HEIGHT, (0.0,0.0,0.0), render_icon_quit, lambda: end_application())
control_button_list = [reset_game_button, pause_game_button, quit_game_button]
def reset_game():
    print("Starting Over")
    global game_status, player_catcher, falling_gem
    game_status = GameStatus()
    player_catcher = GemCatcher()
    falling_gem = FallingGem()
def toggle_game_freeze():
    game_status.is_frozen = not game_status.is_frozen
    print("Paused" if game_status.is_frozen else "Playing")
def end_application():
    print(f"Goodbye. Your score was: {game_status.current_score}")
    glutLeaveMainLoop()
def initialize_gl_settings():
    glClearColor(0.0, 0.0, 0.0, 1.0)
    glPointSize(2.0)
    glMatrixMode(GL_PROJECTION)
    glLoadIdentity()
    gluOrtho2D(0, SCREEN_WIDTH, 0, SCREEN_HEIGHT)
    glMatrixMode(GL_MODELVIEW)
def update_game_logic(val):
    now = time.time()
    delta_time = now - game_status.last_frame_time
    if delta_time > 0.1: delta_time = 0.1
    game_status.last_frame_time = now
    if game_status.is_active and not game_status.is_frozen:
        falling_gem.update_gem_position(delta_time, game_status.gem_fall_rate)
        if game_status.is_auto_pilot:
            player_catcher.move_towards_target_x(falling_gem.pos_x, delta_time)
        if check_box_overlap(get_object_bounding_box(player_catcher), get_object_bounding_box(falling_gem)):
            game_status.current_score += 1
            print(f"Score: {game_status.current_score}")
            game_status.gem_fall_rate += 12.0
            falling_gem.reset_gem_position()
        if falling_gem.pos_y < 0:
            game_status.is_active = False
            player_catcher.display_color = (1.0, 0.0, 0.0)
            print(f"Game Over! Final Score: {game_status.current_score}")
    glutPostRedisplay()
    glutTimerFunc(16, update_game_logic, 0)
def render_game_scene():
    glClear(GL_COLOR_BUFFER_BIT)
    render_icon_reset(reset_game_button.pos_x + reset_game_button.width/2, reset_game_button.pos_y + reset_game_button.height/2, reset_game_button.width * 0.8)
    if game_status.is_frozen:
        render_icon_play_triangle(pause_game_button.pos_x + pause_game_button.width/2, pause_game_button.pos_y + pause_game_button.height/2, pause_game_button.width * 0.8)
    else:
        render_icon_pause_bars(pause_game_button.pos_x + pause_game_button.width/2, pause_game_button.pos_y + pause_game_button.height/2, pause_game_button.width * 0.8)
    render_icon_quit(quit_game_button.pos_x + quit_game_button.width/2, quit_game_button.pos_y + quit_game_button.height/2, quit_game_button.width * 0.8)
    falling_gem.draw()
    player_catcher.draw()
    glutSwapBuffers()
def handle_keyboard_char_input(key, x, y):
    k = key.decode('utf-8') if isinstance(key, bytes) else key
    if k.lower() == 'c':
        game_status.is_auto_pilot = not game_status.is_auto_pilot
        print("Cheat Mode ON" if game_status.is_auto_pilot else "Cheat Mode OFF")
def handle_keyboard_special_input(key, x, y):
    if not game_status.is_active or game_status.is_frozen or game_status.is_auto_pilot:
        return
    step = player_catcher.move_speed * 0.03
    if key == GLUT_KEY_LEFT:
        player_catcher.move_by_x_delta(-step)
    elif key == GLUT_KEY_RIGHT:
        player_catcher.move_by_x_delta(step)
def handle_mouse_button_click(button, state, x, y):
    if button == GLUT_LEFT_BUTTON and state == GLUT_DOWN:
        mouse_x = x
        mouse_y = SCREEN_HEIGHT - y
        if reset_game_button.is_hit(mouse_x, mouse_y):
            reset_game(); return
        if pause_game_button.is_hit(mouse_x, mouse_y):
            toggle_game_freeze(); return
        if quit_game_button.is_hit(mouse_x, mouse_y):
            end_application(); return
def run_game_application():
    glutInit(sys.argv)
    glutInitDisplayMode(GLUT_DOUBLE | GLUT_RGBA)
    glutInitWindowSize(SCREEN_WIDTH, SCREEN_HEIGHT)
    glutCreateWindow(b"Catch the diamonds!")
    initialize_gl_settings()
    glutDisplayFunc(render_game_scene)
    glutKeyboardFunc(handle_keyboard_char_input)
    glutSpecialFunc(handle_keyboard_special_input)
    glutMouseFunc(handle_mouse_button_click)
    game_status.last_frame_time = time.time()
    glutTimerFunc(16, update_game_logic, 0)
    glutMainLoop()
if __name__ == '__main__':
    run_game_application()
